    {
      "id": "ca2a6fa8-9877-4242-9a93-d9e2e6d55029",
      "name": "Build Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        -60
      ],
      "parameters": {
        "jsCode": "// get_service_or_price_info — Build Response\n// price_disclosure decides the ONLY shape a price is ever returned in:\n//   exact          -> price_amount is a real number, safe to state directly\n//   range          -> price_range is a pre-approved string, never computed here\n//   not_disclosed  -> no number or range is returned at all, ever\nconst items = $input.all();\nconst row = items[0] && items[0].json && items[0].json.id ? items[0].json : null;\n\nlet disclaimerNote = null;\ntry {\n  const settingsItem = $('Get Business Settings').first();\n  const policy = settingsItem && settingsItem.json && settingsItem.json.price_policy;\n  disclaimerNote = policy && policy.disclaimer_note ? policy.disclaimer_note : null;\n} catch (e) {\n  disclaimerNote = null;\n}\n\nconst input = $('Validate Input').first().json;\n\nif (!row) {\n  return [{\n    json: {\n      found: false,\n      business_id: input.business_id_input,\n      service_name: input.service_name,\n      message: 'No service matching that description was found. Do not assume it exists or guess a price.',\n    },\n  }];\n}\n\nreturn [{\n  json: {\n    found: true,\n    business_id: input.business_id_input,\n    service_name: row.name,\n    description: row.description,\n    duration_minutes: row.duration_minutes,\n    price_disclosure: row.price_disclosure,\n    price_amount: row.price_disclosure === 'exact' ? row.price_amount : null,\n    price_range: row.price_disclosure === 'range' ? row.price_range : null,\n    disclaimer_note: row.price_disclosure === 'not_disclosed' ? null : disclaimerNote,\n    bookable: !!row.bookable,\n  },\n}];"
      }
    },
