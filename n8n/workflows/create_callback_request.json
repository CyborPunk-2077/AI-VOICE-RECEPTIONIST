      ],
      "parameters": {
        "jsCode": "// create_callback_request — Verify Saved\nconst items = $input.all();\nconst row = items[0] && items[0].json && items[0].json.id ? items[0].json : null;\n\nlet notifyChannel = 'none';\ntry {\n  const settings = $('Get Business Settings').first().json;\n  notifyChannel = settings && settings.callback_notify_channel ? settings.callback_notify_channel : 'none';\n} catch (e) {\n  notifyChannel = 'none';\n}\n\nconst input = $('Validate Input').first().json;\n\nreturn [{\n  json: {\n    saved: !!row,\n    response_ok: {\n      callback_id: row ? row.id : null,\n      status: 'received',\n      received: !!row,\n      business_id: input.business_id_input,\n      customer_name: input.customer_name,\n      customer_phone: input.phone_e164,\n      reason: input.reason,\n      preferred_callback_time: input.preferred_callback_time,\n      notify_channel: notifyChannel,\n      message: 'No real notification channel is wired up yet (see docs/n8n-setup.md); this is recorded as a pending callback for the business to review.',\n    },\n  },\n}];"
      }
    },
