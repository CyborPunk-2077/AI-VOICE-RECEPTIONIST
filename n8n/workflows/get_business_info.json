        "path": "get-business-info",
        "responseMode": "responseNode",
        "authentication": "headerAuth",
        "options": {}
      },
      "webhookId": "get-business-info-placeholder",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_YOUR_N8N_GATEWAY_HEADER_AUTH_CREDENTIAL",
          "name": "ReceptionFlow Gateway Shared Secret (placeholder)"
        }
      }
    },
    {
      "id": "fa6a4d8d-e283-4892-af59-0e494921196f",
      "name": "Validate Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -840,
        0
      ],
      "parameters": {
        "jsCode": "// get_business_info — Validate Input\nconst body = $input.first().json.body || {};\nconst businessId = String(body.business_id ?? '').trim();\n\nconst errors = [];\nif (!businessId) errors.push('business_id is required');\n\nreturn [{ json: { valid: errors.length === 0, errors, business_id_input: businessId } }];"
      }
    },
