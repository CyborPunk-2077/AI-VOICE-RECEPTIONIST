    {
      "id": "4a91e793-a8be-4060-9638-8fd84035f353",
      "name": "Build Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        -60
      ],
      "parameters": {
        "jsCode": "// get_business_info — Build Response\n// Services and FAQs use onError = continueRegularOutput above (rather\n// than the usual error-branching pattern): a business with no rows yet\n// in either table is a normal, valid state -- not a failure -- so this\n// just treats a failed/empty fetch as an empty list instead of erroring\n// the whole call. Hours/directions/services/FAQs are the only things the\n// assistant is allowed to speak from; nothing here is invented.\nconst business = $('Normalize Business').first().json;\nconst settings = $('Normalize Settings').first().json;\n\nlet services = [];\ntry {\n  services = $('Get Services').all().map((i) => i.json).filter((s) => s && s.id)\n    .map((s) => ({ name: s.name, duration_minutes: s.duration_minutes, bookable: !!s.bookable }));\n} catch (e) {\n  services = [];\n}\n\nlet faqs = [];\ntry {\n  faqs = $('Get Faqs').all().map((i) => i.json).filter((f) => f && f.question);\n} catch (e) {\n  faqs = [];\n}\n\nreturn [{\n  json: {\n    business_id: $('Validate Input').first().json.business_id_input,\n    business_name: business.business_name,\n    industry: settings.industry,\n    languages_supported: settings.languages_supported,\n    default_language: settings.default_language,\n    timezone: business.timezone,\n    currency: settings.currency,\n    contact: {\n      address: business.address,\n      phone_display: business.phone_display,\n      directions_note: settings.directions_note,\n    },\n    opening_hours: settings.opening_hours,\n    hours_text: business.hours_text,\n    services,\n    faqs,\n    booking: { enabled: settings.booking_enabled },\n    availability_source: settings.availability_source,\n    restricted_topics: settings.restricted_topics,\n  },\n}];"
      }
    },
