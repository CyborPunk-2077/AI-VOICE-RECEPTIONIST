        -180,
        -60
      ],
      "parameters": {
        "jsCode": "// Normalize Business\nconst items = $input.all();\nconst row = items[0] && items[0].json && items[0].json.id ? items[0].json : null;\n\nreturn [{\n  json: {\n    business_found: !!row,\n    business_id: row ? row.id : null,\n    business_name: row ? row.name : null,\n    address: row ? row.address : null,\n    phone_display: row ? row.phone : null,\n    timezone: row ? row.timezone : null,\n    hours_text: row ? row.hours_text : null,\n  },\n}];"
      }
    },
