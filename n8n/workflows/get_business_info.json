    {
      "id": "41749986-b025-4f37-92db-db726a16ab32",
      "name": "Normalize Settings",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        -60
      ],
      "parameters": {
        "jsCode": "// Normalize Settings\n// No settings row means this business hasn't been configured yet --\n// everything defaults to the most conservative, no-guessing option\n// (booking disabled, availability not tracked, no restricted topics\n// beyond the universal ones the prompt template already enforces).\nconst items = $input.all();\nconst row = items[0] && items[0].json && items[0].json.business_id ? items[0].json : null;\n\nreturn [{\n  json: {\n    industry: row ? row.industry : null,\n    languages_supported: row && row.languages_supported ? row.languages_supported : ['English'],\n    default_language: row ? row.default_language : 'English',\n    currency: row ? row.currency : null,\n    directions_note: row ? row.directions_note : null,\n    opening_hours: row && row.opening_hours ? row.opening_hours : {},\n    booking_enabled: row ? !!row.booking_enabled : false,\n    availability_source: row ? row.availability_source : 'not_tracked',\n    restricted_topics: row && row.restricted_topics ? row.restricted_topics : [],\n  },\n}];"
      }
    },
    {
