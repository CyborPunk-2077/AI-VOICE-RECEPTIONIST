# ==========================================================================
# VOICE GATEWAY — the live Indian-number path (apps/voice-gateway)
# ==========================================================================
# This is what you need for a real call on a real Indian number.
# Everything below is server-side only. See docs/exotel-setup.md.

# --- Run with no keys and no spend ---------------------------------------
# Runs the entire call path — endpointing, tool calls, barge-in, teardown —
# with fake speech and a scripted model. The right way to test the plumbing.
# MOCK_PROVIDERS=1

# --- Speech (Sarvam covers both STT and TTS with one key) ----------------
# Indian provider, trained on Indic speech. Best choice for Hindi/English
# code-switching and for pronouncing Indian names, places, and rupee
# amounts correctly.
SARVAM_API_KEY=YOUR_SARVAM_API_KEY
# SARVAM_SPEAKER=anushka        # voices differ a lot — audition them

# Fallbacks, used only if SARVAM_API_KEY is unset:
# DEEPGRAM_API_KEY=             # STT; language=multi handles code-switching
# ELEVENLABS_API_KEY=           # TTS; very natural, higher latency/cost
# ELEVENLABS_VOICE_ID=

# --- The model -----------------------------------------------------------
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# ANTHROPIC_API_KEY=            # alternative to OpenAI
# LLM_MODEL=gpt-4o-mini         # smaller = faster = better on a phone call

# --- Exotel (the India-compliant carrier) --------------------------------
# Generate this yourself, then put the same value in the ?secret= of every
# applet URL. Without it, anyone who finds your gateway URL can drive your
# agent and run up your API bill.
EXOTEL_WEBHOOK_SECRET=GENERATE_A_LONG_RANDOM_VALUE

# Only needed for REST-initiated transfers. The Connect applet works without
# these. From Exotel dashboard -> API Settings.
EXOTEL_API_KEY=YOUR_EXOTEL_API_KEY
EXOTEL_API_TOKEN=YOUR_EXOTEL_API_TOKEN
EXOTEL_ACCOUNT_SID=YOUR_EXOTEL_ACCOUNT_SID
# EXOTEL_SUBDOMAIN=api.exotel.com

# --- Telephony audio ------------------------------------------------------
# Indian telephony is 8kHz mono 16-bit PCM. Change only if Exotel tells you
# your trunk hands over something else — a mismatch here sounds like static.
# TELEPHONY_SAMPLE_RATE=8000

# Wire format on the carrier leg: "pcm" (linear 16-bit, the default and what
# Exotel's Voicebot applet normally offers) or "mulaw" (G.711 µ-law, which
# some trunks hand over instead). Ask Exotel which one your account is set
# to rather than guessing — the wrong value is loud static in both
# directions, not silence, and it will not show up in any log.
# Test it before you dial:
#   node apps/voice-gateway/server.mjs
#   node scripts/simulate-call.mjs --encoding mulaw
# TELEPHONY_ENCODING=pcm

# Business used when an applet URL omits ?business=<slug>.
# DEFAULT_BUSINESS=sharma-dental

# --- Agent server (apps/agent-server, the console) -----------------------
# Required before you expose the console or its tool webhooks publicly.
# AGENT_SERVER_SECRET=GENERATE_A_LONG_RANDOM_VALUE


# ReceptionFlow — environment variable reference
# Copy the values you need into apps/dashboard/.env.local (dashboard) and/or
# your other services' env files. Never commit real values — this file only
# ever contains placeholders. See docs/database.md for setup steps.

# --- Supabase (dashboard: Overview, Calls, Appointments pages) ---
# Project Settings -> API in your Supabase project. Client-side (anon-safe
# by design — protected by RLS, not a secret).
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Whose dashboard this is — shown in the sidebar, page headers, and the
# browser tab. Defaults to "Lumen Salon", the business in supabase/seed.sql.
# The dashboard is single-business; the agent core is not. See docs/todo.md.
# NEXT_PUBLIC_BUSINESS_NAME=Sharma Dental

# --- n8n workflows (n8n/workflows/*.json) ---
# Set these in the environment your local n8n runs in, NOT in this repo's
# app env files. The workflows read them via $env in HTTP Request nodes.
# This is the service-role key, not the publishable one above: RLS denies
# writes to anon, and n8n has to insert appointments and calls.
# See docs/n8n-setup.md.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# Same value as NEXT_PUBLIC_SUPABASE_URL, named without the NEXT_PUBLIC_
# prefix because n8n is not a Next.js app.
SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL

# --- Vapi tool gateway (apps/dashboard/src/app/api/vapi/*) — Phase 5.7 ---
# ALL of these are SERVER-SIDE ONLY: none are NEXT_PUBLIC_-prefixed, so
# Next.js never inlines them into browser JavaScript. Set them in
# apps/dashboard/.env.local (or your deployment platform's server-side env
# config) — never in a NEXT_PUBLIC_ variable, never in config/vapi-tools.json,
# never in n8n/workflows/*.json. See docs/n8n-setup.md "Vapi tool gateway".
#
# The gateway route handlers use SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY
# above too (to read vapi_business_map, which has no anon-readable RLS
# policy — see supabase/migrations/0003_vapi_gateway.sql), so both of
# those are now needed by the dashboard's server process as well as n8n,
# not just n8n.

# The shared secret Vapi signs its webhook requests with. Configured on
# the Vapi side as that assistant/org's "Server URL Secret" or HMAC
# signing credential (exact dashboard label depends on Vapi's current
# UI — no live Vapi account exists in this repo to confirm against).
# Until this is set to a real value, the gateway fails closed and
# rejects every request with 503 — it never falls back to "no auth".
VAPI_WEBHOOK_SECRET=YOUR_VAPI_WEBHOOK_HMAC_SECRET

# Optional — override the header names the gateway reads the signature
# and timestamp from, if Vapi's current dashboard lets you choose them or
# uses different defaults than assumed here. Leave unset to use the
# defaults (x-vapi-signature / x-vapi-timestamp). Set
# VAPI_TIMESTAMP_HEADER=disabled to skip replay/timestamp checking
# entirely (signature-only) if your Vapi credential doesn't sign a
# timestamp at all.
# VAPI_SIGNATURE_HEADER=x-vapi-signature
# VAPI_TIMESTAMP_HEADER=x-vapi-timestamp
# VAPI_SIGNATURE_MAX_SKEW_SECONDS=300

# The private, internal secret the gateway sends to n8n on every forwarded
# request, and that every n8n workflow's Webhook node Header Auth
# credential must be configured with the exact same value for (see
# docs/n8n-setup.md step 3). This is what makes n8n/workflows/*.json's
# webhook URLs unusable to anyone who can reach them directly but doesn't
# know this secret. Generate a long random value yourself — this is not a
# value Vapi or anyone else provides.
N8N_GATEWAY_SHARED_SECRET=YOUR_INTERNAL_N8N_GATEWAY_SHARED_SECRET
# Optional — header name the secret above is sent under. Must match the
# Header Auth credential's configured header name in n8n.
# N8N_GATEWAY_HEADER_NAME=x-receptionflow-gateway-secret

# The PRIVATE base URL of your n8n instance (e.g. an ngrok tunnel to
# localhost, or a non-public internal hostname) — never the public-facing
# URL you'd hand to Vapi directly, since Vapi no longer talks to n8n
# directly at all (see config/vapi-tools.json's _phase_5_7_trust_model).
# Only the gateway (server-side) ever reads this.
N8N_BASE_URL=YOUR_PRIVATE_N8N_BASE_URL

# --- Not yet in use in this repo (later phases, see docs/todo.md) ---
# Twilio and Google Calendar account credentials are not here. Google auth
# is configured as an n8n credential, not an env var; Twilio is a later
# phase. Do not add them speculatively. Vapi's own account/assistant/phone
# number creation is also not here — only the webhook secret above, which
# is configuration for a gateway this repo can build and test without a
# live Vapi account.
